{
	"name": "nextjs-template",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build --webpack",
		"start": "next start",
		"lint": "TIMING=1 eslint --cache .",
		"format": "prettier --write --cache --experimental-cli .",
		"typecheck": "rm -rf .next/types && next typegen && tsc -p tsconfig.json --noEmit",
		"api:generate": "openapi-typescript http://localhost:3001/docs-yaml --default-non-nullable false --output openapi/api.ts && prettier --write --cache openapi/*.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@hookform/resolvers": "^5.7.1",
		"@serwist/next": "^9.5.13",
		"@tanstack/react-query": "^5.101.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cookies-next": "^6.1.1",
		"lucide-react": "^1.31.0",
		"motion": "^13.1.0",
		"next": "16.4.2",
		"next-intl": "^4.13.6",
		"next-themes": "^0.4.6",
		"nuqs": "^2.9.5",
		"openapi-fetch": "^0.17.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "^7.85.0",
		"shadcn": "^4.22.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@tanstack/eslint-plugin-query": "^5.101.4",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"eslint": "^9",
		"eslint-config-mahir": "^1.3.3",
		"husky": "^9.1.7",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.6",
		"serwist": "^9.5.13",
		"tailwindcss": "^4.3.3",
		"typescript": "^6"
	}
}
